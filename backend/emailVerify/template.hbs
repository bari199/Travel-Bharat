<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Verify Your Email</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #f5f7fb;
      font-family: Arial, Helvetica, sans-serif;
      color: #444;
      padding: 30px 15px;
    }

    .wrapper {
      max-width: 600px;
      margin: auto;
      background: #ffffff;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, .08);
    }

    .header {
      background: linear-gradient(135deg, #ff8a00, #ffb000);
      padding: 35px 20px;
      text-align: center;
    }

    .header h1 {
      color: #ffffff;
      font-size: 28px;
      margin-bottom: 8px;
    }

    .header p {
      color: rgba(255, 255, 255, .9);
      font-size: 15px;
    }

    .content {
      padding: 40px 35px;
    }

    .content h2 {
      color: #222;
      margin-bottom: 20px;
    }

    .content p {
      font-size: 15px;
      line-height: 1.8;
      color: #555;
      margin-bottom: 18px;
    }

    .button-wrapper {
      text-align: center;
      margin: 35px 0;
    }

    .button {
      display: inline-block;
      background: #ff9800;
      color: #ffffff !important;
      text-decoration: none;
      padding: 14px 30px;
      border-radius: 8px;
      font-size: 15px;
      font-weight: bold;
    }

    .button:hover {
      background: #e68900;
    }

    .note {
      font-size: 13px;
      color: #777;
      margin-top: 20px;
    }

    .footer {
      text-align: center;
      background: #fafafa;
      padding: 20px;
      font-size: 13px;
      color: #999;
      border-top: 1px solid #eee;
    }
  </style>
</head>

<body>

  <div class="wrapper">

    <div class="header">
      <h1>Travel Bharat</h1>
      <p>Email Verification</p>
    </div>

    <div class="content">

      <h2>Hello 👋</h2>

      <p>
        Thank you for creating your <strong>Travel Bharat</strong> account.
      </p>

      <p>
        Please verify your email address to activate your account and start
        exploring India's best travel destinations, experiences, and adventures.
      </p>

      <div class="button-wrapper">
        <a
          href="{{frontendUrl}}/verify/{{token}}"
          class="button"
          target="_blank">
          Verify Email
        </a>
      </div>

      <p class="note">
        This verification link will expire in <strong>10 minutes</strong>.
      </p>

      <p class="note">
        If you didn't create an account, you can safely ignore this email.
      </p>

    </div>

    <div class="footer">
      © 2026 Travel Bharat. All Rights Reserved.
    </div>

  </div>

</body>

</html>